// Synthetic rows for the retrieval replay (tests/component/retrieval_replay):
// what a search may see under access controls. Every source in this file
// carries its secure givens, so all three are gated; open.malloy has the
// ungated ones.
//
//   payroll_ledger  locked: #(authorize) on the secure given ROLE, so a caller
//                   whose givens do not say finance does not see it at all.
//   tenant_orders   gated: an #(access_filter) row gate on the secure given
//                   TENANTS. Its #(index) values are never in the shared
//                   index; a value search pinned to its field reads them with
//                   the caller's givens, and its (deprecated) #(filter)
//                   narrows that read by filter_params.
//   cost_ledger     #(agent-hidden): it holds the best match for "freight
//                   cost", and a search must never return it.
//   departments     open to every caller, joined from payroll_ledger.
//   payslip_prints  open to every caller, joins payroll_ledger: a field of
//                   departments is reached from it only THROUGH the locked
//                   source (payment.dept_row), so a caller the lock refuses
//                   must not be offered that path.
##! experimental.givens

#(secure)
given: ROLE :: string

#(secure)
given: TENANTS :: string[]

#(doc) One row per department.
source: departments is duckdb.sql("""
  select 'Sales' as dept_name, 'Ada Park' as head
  union all select 'Support', 'Lin Ortiz'
""") extend {
  primary_key: dept_name
  #(doc) Name of the department's head.
  dimension: department_head is head
}

#(authorize) 'finance' = $ROLE
#(doc) Payroll ledger: one row per salary payment. Finance only.
source: payroll_ledger is duckdb.sql("""
  select 1 as pay_id, 'Sales' as dept, 3000.0 as gross
  union all select 2, 'Support', 4200.0
""") extend {
  primary_key: pay_id
  #(doc) The department the employee is paid from.
  join_one: dept_row is departments on dept = dept_row.dept_name
  #(doc) Department of the paid employee.
  dimension: department is dept
  #(doc) Gross payroll paid to staff.
  measure: payroll_gross is gross.sum()
}

#(access_filter) tenant in $TENANTS
#(filter) name=tenant dimension=tenant_name type=equal
#(doc) Orders of every tenant; each caller reads only its own tenants' rows.
source: tenant_orders is duckdb.sql("""
  select 1 as order_id, 'acme' as tenant, 'Springfield' as city, 50.0 as total
  union all select 2, 'acme', 'Springfield Gardens', 75.0
  union all select 3, 'globex', 'Springfield', 20.0
  union all select 4, 'globex', 'Capital City', 35.0
""") extend {
  primary_key: order_id
  #(index)
  #(doc) City the tenant's order ships to.
  dimension: order_city is city
  #(doc) The tenant the order belongs to.
  dimension: tenant_name is tenant
  #(doc) Sum of order totals.
  measure: tenant_order_total is total.sum()
}

#(agent-hidden)
#(doc) Freight cost ledger: the freight cost of every shipment, by carrier invoice.
source: cost_ledger is duckdb.sql("""
  select 1 as line_id, 9.5 as freight union all select 2, 11.0
""") extend {
  primary_key: line_id
  #(doc) Total freight cost on carrier invoices.
  measure: freight_cost_total is freight.sum()
}

#(doc) Payslip prints: one row per payslip printed for a salary payment.
source: payslip_prints is duckdb.sql("""
  select 1 as print_id, 1 as pay_id union all select 2, 2
""") extend {
  primary_key: print_id
  #(doc) The salary payment the payslip was printed for.
  join_one: payment is payroll_ledger on pay_id = payment.pay_id
  #(doc) Number of payslips printed.
  measure: payslip_count is count()
}
